# Checkpoint reads one repository's openspec/changes/* on a branch and writes
# decisions.md and checkpoint.json back. Copy to .env.local and fill in.

# Shared access key exchanged for the session cookie (design D1). Leave it
# unset and every gated route answers 503: the app fails closed, never open.
CHECKPOINT_ACCESS_KEY=

# Which git host adapter to use: `github` in production, `fixture` for local
# development and tests (serves fixtures/repo/ with in-memory writes).
CHECKPOINT_GIT_HOST=github

# `owner/name` of the one repository the reader may touch.
CHECKPOINT_REPO=renzrollon/specflow

# Fine-grained personal access token scoped to that one repository with
# Contents: read and write. Required when CHECKPOINT_GIT_HOST=github.
CHECKPOINT_GITHUB_TOKEN=

# Directory the fixture adapter serves. Only read when CHECKPOINT_GIT_HOST=fixture.
CHECKPOINT_FIXTURE_DIR=fixtures/repo
